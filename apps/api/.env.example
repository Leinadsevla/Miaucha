# Copie para .env (que não vai para o git). Segredos com pelo menos 32 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Local (Docker): postgres://miaucha:miaucha@localhost:5432/miaucha
# Supabase: URL do "Session pooler" (botão Connect), não a conexão direta (só IPv6), com SSL verificado:
#   postgresql://postgres.<projeto>:<senha>@<host-do-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-ca.crt
DATABASE_URL=postgres://miaucha:miaucha@localhost:5432/miaucha
JWT_SECRET=
CODE_SECRET=
PORT=3000

# Client IDs OAuth do Google (Android, iOS, web), separados por vírgula. Vazio = login com Google recusado.
GOOGLE_CLIENT_IDS=

# Rate limit das rotas /auth (NF-04): requisições por janela, por IP e por rota.
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000

# Storage S3 compatível para as fotos (NF-05: bucket PRIVADO, fotos só por URL assinada).
# Supabase: Storage → crie o bucket "pet-photos" sem marcar "Public"; Storage → Settings → S3 Connection
# mostra endpoint e região e permite gerar as chaves (Access keys). As chaves dão acesso total ao storage: nunca no app.
STORAGE_ENDPOINT=https://<projeto>.storage.supabase.co/storage/v1/s3
STORAGE_REGION=us-east-1
STORAGE_BUCKET=pet-photos
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Chat (S4): mensagens por janela, por usuário (NF-04).
CHAT_THROTTLE_LIMIT=30
CHAT_THROTTLE_TTL_MS=60000

# Redis para o Socket.IO com MAIS DE UMA instância da API (pub/sub entre elas). Com uma instância, deixe vazio.
REDIS_URL=

# Expo Push (alertas, S5). Opcional: só se o projeto no expo.dev exigir "Enhanced push security".
EXPO_ACCESS_TOKEN=

# Quantos proxies ficam na frente da API (Render: 1). Localmente, 0: o X-Forwarded-For é ignorado.
TRUST_PROXY=0
