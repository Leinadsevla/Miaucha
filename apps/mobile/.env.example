# Copie para .env.local (fora do git). Depois de mudar, recarregue o app por completo.
# Sem esta variável, em desenvolvimento o app usa o login falso (qualquer código de 6 dígitos funciona).
#
# Endereço da apps/api (pnpm dev, porta 3000):
#   emulador Android: http://10.0.2.2:3000
#   simulador iOS:    http://localhost:3000
#   aparelho físico:  http://<IP do computador na rede local>:3000
EXPO_PUBLIC_API_URL=
