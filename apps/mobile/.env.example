# Copie para .env.local (fora do git). Depois de mudar, recarregue o app por completo.
# Sem esta variável, em desenvolvimento o app usa o login falso (qualquer código de 6 dígitos funciona).
#
# Endereço da apps/api (pnpm dev, porta 3000):
#   emulador Android: http://10.0.2.2:3000
#   simulador iOS:    http://localhost:3000
#   aparelho físico:  http://<IP do computador na rede local>:3000
EXPO_PUBLIC_API_URL=

# App web (`npx expo start --web`): endereço da API só para o navegador. A API precisa listar a origem do
# app em CORS_ORIGINS (ex.: apps/api local com CORS_ORIGINS=http://localhost:8081). Vazio = usa a de cima.
EXPO_PUBLIC_WEB_API_URL=

# Modo demonstração (para apresentar): o app inteiro com dados de exemplo, sem API, inclusive o login
# com Google. Vale até num build de produção. Use 1 para ligar; vazio = desligado.
EXPO_PUBLIC_DEMO=
