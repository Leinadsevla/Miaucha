{
  "expo": {
    "name": "Miaucha",
    "slug": "miaucha",
    "scheme": "miaucha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.tcc.miaucha"
    },
    "android": {
      "package": "br.tcc.miaucha",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FF8A3D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FF8A3D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "O Miaucha usa suas fotos para mostrar seu pet no cadastro e nos alertas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Miaucha usa sua localização para mostrar pets perdidos perto de você e marcar onde um pet foi visto. Só a região aproximada aparece para outras pessoas.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF8A3D"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "9da59bd1-20aa-4e69-988d-b1bc09ba9bfd"
      }
    },
    "owner": "leinadsevlas-team",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9da59bd1-20aa-4e69-988d-b1bc09ba9bfd"
    }
  }
}
